#!/bin/sh
# The brainstorm command of an installed app (macOS and Linux). It runs the CLI on the app's own Electron in node
# mode, so the machine needs no Node. Installers link it from a folder on PATH, so the link is resolved first.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
resources=$(cd "$(dirname "$self")/.." && pwd)
if [ -d "$resources/../MacOS" ]; then
  app="$resources/../MacOS/Brainstorm"
else
  app="$resources/../brainstorm-app"
fi
ELECTRON_RUN_AS_NODE=1 exec "$app" "$resources/app/dist/cli/main.js" "$@"
