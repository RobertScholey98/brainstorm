{
  "name": "brainstorm",
  "version": "0.1.0",
  "private": true,
  "description": "A local design canvas attached to a T3 Code thread",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "verify:1": "node scripts/verify/1-storage-api.mjs",
    "lint:skill": "node scripts/lint-skill.mjs",
    "verify:2": "node scripts/verify/2-canvas.mjs",
    "verify:3": "node scripts/verify/3-controls.mjs"
  },
  "dependencies": {
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "@json-render/shadcn": "0.22.0",
    "lucide-react": "0.564.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "3.35.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "44.10.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "bin": {
    "brainstorm": "bin/brainstorm.mjs"
  }
}
