{
  "name": "brainstorm",
  "version": "0.1.0",
  "private": true,
  "description": "A local design canvas attached to a T3 Code thread",
  "homepage": "https://github.com/RobertScholey98/brainstorm",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "verify:1": "node scripts/verify/1-storage-api.mjs",
    "lint:skill": "node scripts/lint-skill.mjs",
    "lint:design": "node scripts/design/lint.mjs",
    "verify:2": "node scripts/verify/2-canvas.mjs",
    "verify:3": "node scripts/verify/3-controls.mjs",
    "verify:4": "node scripts/verify/4-feedback.mjs",
    "verify:5": "node scripts/verify/5-regenerate.mjs",
    "verify:6": "node scripts/verify/6-export.mjs",
    "verify:7": "node scripts/verify/7-shell.mjs",
    "verify:live": "node scripts/verify/live-t3.mjs",
    "capture": "node scripts/capture/gallery.mjs",
    "capture:sheets": "node scripts/capture/sheets.mjs",
    "design:tokens": "node scripts/design/tokens.mjs",
    "design:icon": "node scripts/design/icon.mjs",
    "design:checkpoint": "node scripts/design/checkpoint.mjs",
    "verify:8": "node scripts/verify/8-history.mjs",
    "verify:9": "node scripts/verify/9-header.mjs",
    "verify:update": "node scripts/verify/update.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@json-render/core": "0.22.0",
    "@json-render/react": "0.22.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "electron-updater": "6.8.10",
    "lucide-react": "0.564.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sucrase": "3.35.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "bin": {
    "brainstorm": "bin/brainstorm.mjs"
  }
}
