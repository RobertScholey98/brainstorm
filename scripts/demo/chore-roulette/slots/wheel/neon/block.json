{
  "title": "Neon wheel",
  "props": {
    "data": {
      "crew": {
        "type": "data",
        "description": "the household, with chore points this week",
        "sample": [
          { "name": "You", "color": "#00f0ff", "points": 2 },
          { "name": "Maya", "color": "#ff2bd6", "points": 5 },
          { "name": "Jun", "color": "#f5ff3b", "points": 1 },
          { "name": "Priyanka", "color": "#39ff88", "points": 3 }
        ]
      },
      "chore": { "type": "data", "description": "the chore being drawn for", "sample": { "name": "Bins out", "due": "tonight 21:00" } }
    },
    "appearance": {
      "spinSeconds": { "type": "number", "label": "Spin time", "default": 2.4, "min": 0.6, "max": 6, "step": 0.1, "unit": "s" },
      "accent": { "type": "color", "label": "Accent", "default": "#ff2bd6" },
      "glow": { "type": "number", "label": "Glow", "default": 18, "min": 0, "max": 40, "step": 1, "unit": "px" },
      "palette": { "type": "enum", "label": "Palette", "default": "Night city", "options": ["Night city", "Synthwave", "Acid", "Ice"] },
      "labelStyle": { "type": "enum", "label": "Slice labels", "default": "Names", "options": ["Names", "Initials", "Points"] },
      "fairOdds": { "type": "boolean", "label": "Weight by chores done", "default": true },
      "spinLabel": { "type": "text", "label": "Button text", "default": "Spin" }
    }
  }
}
