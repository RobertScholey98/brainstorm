{
  "title": "Thermal receipt",
  "props": {
    "data": {
      "winner": { "type": "data", "description": "who the draw picked", "sample": { "name": "Jun", "color": "#f5ff3b", "points": 1 } },
      "chore": { "type": "data", "description": "the chore, with its due time and points", "sample": { "name": "Bins out", "due": "tonight 21:00", "points": 1 } },
      "crew": {
        "type": "data",
        "description": "the household, for the odds table",
        "sample": [
          { "name": "You", "color": "#00f0ff", "points": 2 },
          { "name": "Maya", "color": "#ff2bd6", "points": 5 },
          { "name": "Jun", "color": "#f5ff3b", "points": 1 },
          { "name": "Priyanka", "color": "#39ff88", "points": 3 }
        ]
      },
      "ticket": { "type": "data", "description": "the draw's running number", "sample": 214 }
    },
    "appearance": {
      "paper": { "type": "color", "label": "Paper", "default": "#f1f3ee" },
      "printSeconds": { "type": "number", "label": "Print time", "default": 1.2, "min": 0.2, "max": 3, "step": 0.1, "unit": "s" },
      "typeface": { "type": "enum", "label": "Typeface", "default": "Cascadia Mono", "options": ["Cascadia Mono", "Consolas", "Courier New", "Lucida Console"] },
      "edge": { "type": "enum", "label": "Tear edge", "default": "Zigzag", "options": ["Zigzag", "Straight", "Torn"] },
      "showOdds": { "type": "boolean", "label": "Print the odds", "default": true },
      "footer": { "type": "text", "label": "Footer", "default": "Tear off. Stick it on the fridge.", "multiline": true }
    }
  }
}
