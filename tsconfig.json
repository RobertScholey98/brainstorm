{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": ["src", "test", "vitest.config.ts"],
  "exclude": ["src/canvas/runtime.tsx", "src/renderer", "test/kit-lib", "test/app-fixture", "test/.kit-*"]
}
